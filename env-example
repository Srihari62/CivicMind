# =========================================================================
# CivicMind - Civic Platform Environment Variables Template
# Copy this file to '.env.local' and populate with actual credentials.
# Do NOT commit '.env.local' to source control.
# =========================================================================

# -------------------------------------------------------------------------
# Firebase Web SDK Configuration (Client-side & Server-side accessible)
# -------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# -------------------------------------------------------------------------
# Google Maps Platform Configuration (Client-side & Server-side accessible)
# -------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# -------------------------------------------------------------------------
# Google AI SDK (Gemini) Configuration
# Crucial: Kept server-side only (no NEXT_PUBLIC_ prefix) to secure the API Key
# -------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------------------
# Cloudinary Media Storage Configuration (Unsigned uploads)
# -------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ------------------------------------------------------------------------
# Next.js Application Settings
# -------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
