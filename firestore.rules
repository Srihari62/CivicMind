rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global authorization helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Safely retrieve caller profile data to inspect roles
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isOfficer() {
      return hasRole('officer');
    }

    // ==========================================
    // 1. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Authenticated users can read profiles to resolve display names and assignments
      allow read: if isAuthenticated();
      // Users can register/initialize their own profiles
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Users can modify their own settings/status, admins can manage all users
      allow update: if isOwner(userId) || isAdmin();
      // Only admins can delete profiles
      allow delete: if isAdmin();

      // Nested points transactions subcollection
      match /pointsTransactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAuthenticated();
      }
    }

    // ==========================================
    // 2. REPORTS COLLECTION
    // ==========================================
    match /reports/{reportId} {
      // Authenticated users can query and view incident feeds and details
      allow read: if isAuthenticated();
      // Authenticated citizens can submit new incidents
      allow create: if isAuthenticated();
      // Citizens can increment votes/verifications and attach evidence; officers and admins can escalate/assign/resolve
      allow update: if isAuthenticated();
      // Deletions are restricted exclusively to administrators
      allow delete: if isAdmin();

      // Nested comments collection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }

      // Nested report verifications collection
      match /reportVerifications/{verificationId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.auth.uid == verificationId;
        allow delete: if isAdmin();
      }
    }

    // ==========================================
    // 3. NOTIFICATIONS COLLECTION
    // ==========================================
    match /notifications/{notificationId} {
      // Users can only view, mark read, or dismiss their own notifications
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Clients can trigger notifications for other entities (e.g., dispatchers or assignees)
      allow create: if isAuthenticated();
    }

    // ==========================================
    // 4. AUDIT LOGS COLLECTION
    // ==========================================
    match /audit_logs/{logId} {
      // Audit logs are visible only to administrators
      allow read: if isAdmin();
      // System workflows and authenticated users can log audit history
      allow create: if isAuthenticated();
      // System logs are immutable; only administrators can prune or modify
      allow update, delete: if isAdmin();
    }
  }
}
